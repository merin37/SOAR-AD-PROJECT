<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>
<group name="windows,rdp,custom_detection,">

  <rule id="100100" level="10">
    <if_sid>92657</if_sid>
    <field name="win.eventdata.logonType">^3$</field>
    <field name="win.eventdata.authenticationPackageName">^NTLM$</field>
    <field name="win.eventdata.ipAddress" negate="yes">^127\.0\.0\.1$|^10\.|^192\.168\.|^::1$|^-$</field>
    <description>Possible unauthorized RDP logon: $(win.eventdata.targetUserName) from $(win.eventdata.ipAddress)</description>
    <mitre>
      <id>T1021.001</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,rdp_network_logon,attack,</group>
  </rule>

</group>