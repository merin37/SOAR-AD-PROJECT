    {
      "type": "Agents::EventTransformationAgent",
      "name": "Risk_verdict",
      "disabled": false,
      "description": null,
      "guid": "3598e96401b7ab9fbfeb8a5e9a6fe369",
      "origin_story_identifier": "cloud:2f8da1140e77e7333f8313435a925123:810ccdbf57b67a5b7ede98fe6df88f8c",
      "options": {
        "mode": "automatic",
        "input": "=risk_analysis",
        "guidance": "You are a Tier 2 SOC analyst reviewing a Wazuh detection alert for a successful unauthorized RDP-style network logon. You will produce a structured triage decision AND a short analyst briefing in a single output.\n\nSCORING RULES:\n- Start with the AbuseIPDB confidence score (abuse_score, 0-100).\n- Add 10 points per VirusTotal vendor flagging the IP as malicious (vt_malicious).\n- Cap the numeric score at 100. Call the result final_score.\n- If is_tor is true, the verdict is HIGH regardless of final_score.\n\nVERDICT SELECTION:\n- final_score >= 75 OR is_tor is true → verdict = HIGH\n- final_score 40-74 → verdict = MEDIUM\n- final_score 1-39 → verdict = LOW\n- final_score = 0 → verdict = CLEAN\n\nOUTPUT FIELDS TO INCLUDE (in addition to the raw fields you already emit):\n- final_score: the computed integer, 0-100\n- verdict: one of HIGH, MEDIUM, LOW, CLEAN\n- summary: exactly 2 sentences describing what happened. MUST reference specific values from the input: target_user, src_ip, country, isp. Do NOT use vague language.\n- recommended_action: 1 sentence appropriate to the verdict.\n    * HIGH: immediate escalation / disable account.\n    * MEDIUM: investigate now, contact user to verify.\n    * LOW: verify with user; likely benign but document.\n    * CLEAN: document and close.\n\nSTRICT RULES:\n- Use ONLY the data provided in the input. Do NOT invent facts.\n- Base your analysis on: target_user, src_ip, country, isp, is_tor, abuse_score, vt_malicious, attacker_workstation, hostname.\n- The summary must name-drop specific values, not paraphrase.\n- Do not contradict the mathematical verdict in the summary or recommendation.",
        "language": "python_3_13",
        "script": "from typing import Any\n\n\ndef _to_bool(value: Any) -> bool:\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, str):\n        return value.strip().lower() in (\"true\", \"1\", \"yes\")\n    if isinstance(value, (int, float)):\n        return value != 0\n    return False\n\n\ndef _to_int(value: Any) -> int:\n    try:\n        if value is None or value == \"\":\n            return 0\n        return int(float(value))\n    except (ValueError, TypeError):\n        return 0\n\n\ndef main(input: dict) -> dict:\n    src_ip = input.get(\"src_ip\") or \"unknown IP\"\n    target_user = input.get(\"target_user\") or \"an unspecified user\"\n    attacker_workstation = input.get(\"attacker_workstation\") or \"an unspecified workstation\"\n    country = input.get(\"country\") or \"an unspecified country\"\n    isp = input.get(\"isp\") or \"an unspecified ISP\"\n    hostname = input.get(\"hostname\") or \"an unspecified hostname\"\n    abuse_link = input.get(\"abuse_link\") or \"\"\n    vt_link = input.get(\"vt_link\") or \"\"\n\n    abuse_score = _to_int(input.get(\"abuse_score\"))\n    vt_malicious = _to_int(input.get(\"vt_malicious\"))\n    is_tor = _to_bool(input.get(\"is_tor\"))\n\n    final_score = abuse_score + (vt_malicious * 10)\n    final_score = max(0, min(final_score, 100))\n\n    if is_tor or final_score >= 75:\n        verdict = \"HIGH\"\n    elif 40 <= final_score <= 74:\n        verdict = \"MEDIUM\"\n    elif 1 <= final_score <= 39:\n        verdict = \"LOW\"\n    else:\n        verdict = \"CLEAN\"\n\n    summary = (\n        f\"A successful RDP-style logon was observed for target user {target_user} from source IP {src_ip} \"\n        f\"(hostname {hostname}), originating from {country} via ISP {isp}, with the connection reaching attacker workstation {attacker_workstation}. \"\n        f\"This IP has an AbuseIPDB confidence score of {abuse_score}, was flagged as malicious by {vt_malicious} VirusTotal vendor(s), \"\n        f\"and {'is associated with a Tor exit node' if is_tor else 'is not associated with Tor'}, yielding a final risk score of {final_score} and a {verdict} verdict.\"\n    )\n\n    if verdict == \"HIGH\":\n        recommended_action = (\n            f\"Immediately escalate this incident and disable the account for {target_user} pending further investigation.\"\n        )\n    elif verdict == \"MEDIUM\":\n        recommended_action = (\n            f\"Investigate this logon now and contact {target_user} to verify whether they initiated the connection from {src_ip}.\"\n        )\n    elif verdict == \"LOW\":\n        recommended_action = (\n            f\"Verify with {target_user} that the login from {src_ip} was legitimate; this is likely benign but should be documented.\"\n        )\n    else:\n        recommended_action = (\n            f\"Document this event as clean for {target_user} from {src_ip} and close the alert.\"\n        )\n\n    return {\n        \"src_ip\": src_ip,\n        \"target_user\": target_user,\n        \"attacker_workstation\": attacker_workstation,\n        \"abuse_score\": abuse_score,\n        \"vt_malicious\": vt_malicious,\n        \"country\": country,\n        \"isp\": isp,\n        \"is_tor\": is_tor,\n        \"hostname\": hostname,\n        \"abuse_link\": abuse_link,\n        \"vt_link\": vt_link,\n        \"final_score\": final_score,\n        \"verdict\": verdict,\n        \"summary\": summary,\n        \"recommended_action\": recommended_action,\n    }"
      },
      "reporting": {
        "time_saved_value": 0,
        "time_saved_unit": "minutes"
      },
